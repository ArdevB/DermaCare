PORT=5000
NODE_ENV=development

MONGODB_URI=

JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary (https://cloudinary.com/console) - required, product images
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dermacare/products

# Google Gemini (https://aistudio.google.com/apikey) - required, auto product descriptions
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Resend (https://resend.com/api-keys) - optional, needed for email verification
# and password reset emails. Endpoints return a clear 503 until this is set.
RESEND_API_KEY=
# Must be a verified sender/domain in your Resend account, e.g. "DermaCare <no-reply@yourdomain.com>"
EMAIL_FROM=

# Khalti (https://admin.khalti.com/) - optional, needed only for Khalti payments.
# Use your TEST secret key while developing; KHALTI_ENV=live switches to the production API.
KHALTI_SECRET_KEY=
KHALTI_ENV=sandbox

# Used to build links in emails (verify/reset) and Khalti's redirect URLs
FRONTEND_URL=http://localhost:5173

CORS_ORIGIN=http://localhost:5173
